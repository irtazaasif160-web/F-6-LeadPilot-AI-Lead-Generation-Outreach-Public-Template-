    {
      "parameters": {
        "promptType": "define",
        "text": "=Write a personalized outreach email for this qualified lead.\n\nBusiness Name:\n{{ $json.business_name }}\n\nBusiness Summary:\n{{ $json.business_summary }}\n\nRecommended Automation Service:\n{{ $json.recommeded_service }}\n\nAutomation Opportunity:\n{{ $json.automation_opportunity }}\n\nQualification Reason:\n{{ $json.qualification_reason }}\n\nThe email should introduce the relevant automation idea naturally and aim to start a conversation or offer a brief demo.",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "You are a professional B2B outreach email writer for an AI automation freelancer.\n\nWrite a short, personalized cold outreach email based ONLY on the business information and automation opportunity provided.\n\nGOAL:\nStart a conversation and offer a brief demo/discussion. Do not aggressively sell or try to close the deal in the first email.\n\nRULES:\n- Keep the email concise and natural.\n- Do not invent facts, problems, results, clients, case studies, or statistics.\n- Do not claim the business currently has inefficient or manual processes unless explicitly stated.\n- Focus on the specific automation opportunity identified during lead qualification.\n- Explain the potential benefit in simple business language.\n- Do not mention n8n unless it is genuinely useful.\n- Do not mention AI unnecessarily.\n- Avoid spammy language, exaggerated claims, and fake urgency.\n- Do not include website development, SEO, hosting, domains, security, or maintenance services.\n- Do not include placeholders such as [Name] or [Company].\n- Do not include a signature; it will be handled separately.\n- End with a simple, low-pressure call to action asking whether they would be open to seeing/discussing the idea.\n\nReturn ONLY valid JSON in exactly this structure:\n\n{\n  \"email_subject\": \"\",\n  \"email_body\": \"\"\n}"
            }
          ]
        },
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
