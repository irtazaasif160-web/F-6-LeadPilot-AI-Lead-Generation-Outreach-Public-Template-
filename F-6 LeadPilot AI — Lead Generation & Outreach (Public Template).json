      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const existingLeads = $(\"Get Existing Leads\").all();\n\nconst placeId = String($json.id || \"\")\n  .trim()\n  .toLowerCase();\n\nconst isDuplicate = existingLeads.some(item => {\n  const existingId = String(item.json.lead_id || \"\")\n    .trim()\n    .toLowerCase();\n\n  return existingId && existingId === placeId;\n});\n\nreturn {\n  json: {\n    ...$json,\n    is_duplicate: isDuplicate\n  }\n};"
      },
