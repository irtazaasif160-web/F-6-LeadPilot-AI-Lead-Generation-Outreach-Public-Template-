    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const emails = Array.isArray($json.emails)\n  ? $json.emails\n  : ($json.emails ? [$json.emails] : []);\n\nconst clean = (value) => {\n  if (!value) return \"\";\n\n  if (Array.isArray(value)) {\n    value = value.join(\" \");\n  }\n\n  return String(value)\n    .replace(/\\u00A0/g, \" \")\n    .replace(/\\s+/g, \" \")\n    .trim();\n};\n\nconst pageTitle = clean($json.page_title);\nconst metaDescription = clean($json.meta_description);\n\nconst headings = [...new Set(\n  ($json.headings || [])\n    .map(clean)\n    .filter(text => text.length > 2)\n)];\n\nconst paragraphs = [...new Set(\n  ($json.paragraphs || [])\n    .map(clean)\n    .filter(text => text.length >= 40)\n)];\n\n// Build structured business context\nlet websiteContext = [\n  pageTitle && `Page Title: ${pageTitle}`,\n  metaDescription && `Description: ${metaDescription}`,\n  headings.length && `Headings: ${headings.join(\" | \")}`,\n  paragraphs.length && `Website Information: ${paragraphs.join(\" \")}`\n]\n  .filter(Boolean)\n  .join(\"\\n\");\n\n// Protect DeepSeek token usage\nconst MAX_CHARS = 4000;\n\nif (websiteContext.length > MAX_CHARS) {\n  websiteContext = websiteContext.slice(0, MAX_CHARS);\n}\n\nreturn {\n  json: {\n    emails,\n    page_title: pageTitle,\n    meta_description: metaDescription,\n    website_context: websiteContext,\n    website_context_length: websiteContext.length\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1552,
        192
      ],
      "id": "a7a4281b-e6fb-4533-98e7-7a1a5a1072aa",
      "name": "Clean Website Content"
